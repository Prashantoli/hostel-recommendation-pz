# Docker Environment Variables
NODE_ENV=production
PORT=3000

# Database Configuration (Docker)
MONGODB_URI=mongodb://admin:password123@mongodb:27017/hostel_finder?authSource=admin

# OAuth Configuration (replace with your actual credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random_123456789
JWT_EXPIRES_IN=7d

# Session Configuration
SESSION_SECRET=your_session_secret_make_it_random_and_secure_987654321
